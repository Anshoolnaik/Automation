// Editor/ESLint umbrella config. `pnpm typecheck` uses the stricter split
// tsconfig.node.json (main, preload) and tsconfig.web.json (renderer).
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["electron.vite.config.ts", "src"]
}
