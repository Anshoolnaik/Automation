{
  "name": "atlas-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas Agent — AI-ready browser automation platform (Phase 1: core browser automation shell)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm extension:build && pnpm --filter @atlas/desktop dev",
    "start": "pnpm build && pnpm --filter @atlas/desktop preview",
    "build": "pnpm extension:build && pnpm --filter @atlas/desktop build",
    "extension:build": "pnpm --filter @atlas/extension build",
    "extension:watch": "pnpm --filter @atlas/extension watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck"
  },
  "devDependencies": {
    "@atlas/agent-core": "workspace:*",
    "@atlas/agent-protocol": "workspace:*",
    "@atlas/agent-server": "workspace:*",
    "@atlas/browser-core": "workspace:*",
    "@atlas/command-parser": "workspace:*",
    "@atlas/database": "workspace:*",
    "@atlas/logger": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
